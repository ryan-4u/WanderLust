<% layout("/layouts/boilerplate") %>

<div class="form-page">
  <div class="form-page-header">
    <h2 class="form-title">Create a Listing</h2>
    <p class="form-sub">Fill in the details below to list your place on WanderLust</p>
  </div>

  <form method="POST" action="/listings" class="needs-validation" novalidate enctype="multipart/form-data">

    <div class="form-group">
      <label class="form-lbl">Title</label>
      <input type="text" name="listing[title]" placeholder="Add a catchy title" class="form-inp" required>
      <div class="valid-feedback">Looks good!</div>
      <div class="invalid-feedback">Title is required</div>
    </div>

    <div class="form-group">
      <label class="form-lbl">Description</label>
      <textarea name="listing[description]" placeholder="Describe your place..." class="form-inp form-inp-ta-tall" required></textarea>
      <div class="invalid-feedback">Please add a description</div>
    </div>

    <div class="form-row-3">
      <div class="form-group">
        <label class="form-lbl">Price <span class="form-lbl-sub">₹ / night</span></label>
        <input type="number" min="1" name="listing[price]" placeholder="1200" class="form-inp" required>
        <div class="invalid-feedback">Enter a valid price</div>
      </div>
      <div class="form-group">
        <label class="form-lbl">Country</label>
        <input type="text" name="listing[country]" placeholder="India" class="form-inp" required>
        <div class="invalid-feedback">Country is required</div>
      </div>
      <div class="form-group">
        <label class="form-lbl">Category</label>
        <select name="listing[category]" class="form-inp form-inp-select" required>
          <option value="" disabled selected>-- Select --</option>
          <option value="Trending">Trending</option>
          <option value="Rooms">Rooms</option>
          <option value="Iconic Cities">Iconic Cities</option>
          <option value="Mountains">Mountains</option>
          <option value="Castle">Castle</option>
          <option value="Amazing Pools">Amazing Pools</option>
          <option value="Camping">Camping</option>
          <option value="Farms">Farms</option>
          <option value="Arctic">Arctic</option>
          <option value="Domes">Domes</option>
          <option value="Boats">Boats</option>
        </select>
        <div class="invalid-feedback">Please select a category</div>
      </div>
    </div>

    <div class="form-row-file-loc">
      <div class="form-group">
        <label class="form-lbl">Image</label>
        <input type="file" name="listing[image]" class="form-inp form-inp-file" accept="image/*">
      </div>
      <div class="form-group">
        <label class="form-lbl">Location</label>
        <input type="text" name="listing[location]" placeholder="Hisar, Haryana" class="form-inp" required>
        <div class="invalid-feedback">Location is required</div>
      </div>
    </div>

    <button class="form-submit-btn">Create Listing</button>

  </form>
</div>