<% layout("/layouts/boilerplate.ejs") %>

<div id="filters">
    <% 
    const categories = [
        { name: "Trending",      icon: "fa-solid fa-fire" },
        { name: "Rooms",         icon: "fa-solid fa-bed" },
        { name: "Iconic Cities", icon: "fa-solid fa-mountain-city" },
        { name: "Mountains",     icon: "fa-solid fa-mountain" },
        { name: "Castle",        icon: "fa-brands fa-fort-awesome" },
        { name: "Amazing Pools", icon: "fa-solid fa-person-swimming" },
        { name: "Camping",       icon: "fa-solid fa-campground" },
        { name: "Farms",         icon: "fa-solid fa-cow" },
        { name: "Arctic",        icon: "fa-regular fa-snowflake" },
        { name: "Domes",         icon: "fa-solid fa-igloo" },
        { name: "Boats",         icon: "fa-solid fa-ship" },
    ];
    %>

    <% for(let cat of categories) { %>
        <a 
            href="/listings?category=<%= encodeURIComponent(cat.name) %>" 
            class="filter <%= activeCategory === cat.name ? 'active-filter' : '' %>"
            style="text-decoration: none; color: inherit;"
        >
            <div><i class="<%= cat.icon %>"></i></div>
            <p><%= cat.name %></p>
        </a>
    <% } %>

    <% if(activeCategory) { %>
        <a href="/listings" class="filter" style="text-decoration:none; color:inherit;">
            <div><i class="fa-solid fa-xmark"></i></div>
            <p>Clear</p>
        </a>
    <% } %>

    <div class="tax-toggle">
        <div class="form-check-reverse form-switch">
            <input class="form-check-input" type="checkbox" role="switch" id="switchCheckDefault">
            <label class="form-check-label" for="switchCheckDefault">Display Total after Taxes</label>
        </div>
    </div>
</div>

<% if(allListings.length === 0) { %>
    <div class="text-center mt-5">
        <h4>No listings found
            <% if(activeCategory) { %> in "<%= activeCategory %>" <% } %>
            <% if(searchQuery) { %> for "<%= searchQuery %>" <% } %>
        </h4>
        <a href="/listings" class="btn btn-outline-danger mt-2">Clear Filters</a>
    </div>
<% } %>

<div class="row row-cols-lg-3 row-cols-md-2 row-cols-1 mt-3" id="listings-grid">
<% for(let listing of allListings){ %>
    <a href="/listings/<%= listing._id %>" class="listing-link">
        <div class="card col listing-card">
            <img src="<%= listing.image.url %>" class="card-img-top" alt="listing-image" style="height: 15rem">
            <div class="card-img-overlay"></div>
            <div class="card-body">
                <p class="card-text">
                    <b><%= listing.title %></b> <br>
                    &#8377; <%= listing.price %> / night
                    <i class="tax-info">&nbsp;&nbsp;+18% GST</i>
                </p>
            </div>
        </div>
    </a>
<% } %>
</div>