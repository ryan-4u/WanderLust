<% layout("/layouts/boilerplate.ejs") %>

<% if(typeof showingFavorites !== 'undefined' && showingFavorites) { %>
  <div class="favorites-banner">
    <i class="fa-solid fa-heart"></i> Your Favorite Stays
    <a href="/listings" class="favorites-clear">Show all listings</a>
  </div>
<% } %>

<div id="filter-bar">
    <div class="filter-arrow" id="filter-prev">&#8249;</div>

    <div id="filters">
        <%
        const categories = [
            { name: "Trending",      icon: "fa-solid fa-fire" },
            { name: "Rooms",         icon: "fa-solid fa-bed" },
            { name: "Iconic Cities", icon: "fa-solid fa-mountain-city" },
            { name: "Mountains",     icon: "fa-solid fa-mountain" },
            { name: "Castle",        icon: "fa-brands fa-fort-awesome" },
            { name: "Amazing Pools", icon: "fa-solid fa-person-swimming" },
            { name: "Camping",       icon: "fa-solid fa-campground" },
            { name: "Farms",         icon: "fa-solid fa-cow" },
            { name: "Arctic",        icon: "fa-regular fa-snowflake" },
            { name: "Domes",         icon: "fa-solid fa-igloo" },
            { name: "Boats",         icon: "fa-solid fa-ship" },
        ];
        %>
        <% for(let cat of categories) { %>
          <div
            class="filter <%= activeCategory === cat.name ? 'active-filter' : '' %>"
            data-category="<%= cat.name %>"
          >
            <div><i class="<%= cat.icon %>"></i></div>
            <p><%= cat.name %></p>
          </div>
        <% } %>
    </div>

    <div class="filter-arrow" id="filter-next">&#8250;</div>

    <div class="filter-clear-btn <%= activeCategory ? 'active' : '' %>" id="filter-clear" title="Clear filter">
      <i class="fa-solid fa-sliders"></i>
    </div>

    <div class="tax-toggle">
        <div class="form-check-reverse form-switch">
            <input class="form-check-input" type="checkbox" role="switch" id="switchCheckDefault">
            <label class="form-check-label" for="switchCheckDefault">Display Total after Taxes</label>
        </div>
    </div>
</div>

<% if(allListings.length === 0) { %>
  <div class="empty-state">
    <% if(typeof showingFavorites !== 'undefined' && showingFavorites) { %>
      <i class="fa-regular fa-heart empty-state-icon"></i>
      <h4>No favorites yet</h4>
      <p>Click the ♡ on any listing to save it here</p>
      <a href="/listings" class="btn-main mt-3">Explore Stays</a>
    <% } else { %>
      <i class="fa-solid fa-magnifying-glass empty-state-icon"></i>
      <h4>No listings found
        <% if(activeCategory) { %> in "<%= activeCategory %>"<% } %>
        <% if(searchQuery) { %> for "<%= searchQuery %>"<% } %>
      </h4>
      <a href="/listings" class="btn-main mt-3">Clear Filters</a>
    <% } %>
  </div>
<% } %>

<div class="row row-cols-lg-3 row-cols-md-2 row-cols-1 mt-3" id="listings-grid">
<% for(let listing of allListings){ %>
  <a href="/listings/<%= listing._id %>" class="listing-link">
    <div class="card col listing-card">
      <div class="listing-img-wrap">
        <img src="<%= listing.image.url %>" class="card-img-top" alt="listing-image">
        <span class="listing-category-badge"><%= listing.category %></span>
          <%
            const isFav = currUser && currUser.favorites &&
                currUser.favorites.map(f => f.toString()).includes(listing._id.toString());
           %>
          <button
            class="heart-btn <%= isFav ? 'favorited' : '' %>"
            data-id="<%= listing._id %>"
          >
            <i class="<%= isFav ? 'fa-solid' : 'fa-regular' %> fa-heart"></i>
          </button>
      </div>
      <div class="card-body">
        <div class="listing-title"><%= listing.title %></div>
        <div class="listing-location"><i class="fa-solid fa-location-dot"></i> <%= listing.location %>, <%= listing.country %></div>
        <div class="listing-price">
          &#8377; <%= listing.price %> <span class="per-night">/ night</span>
          <i class="tax-info">+18% GST</i>
        </div>
      </div>
    </div>
  </a>
<% } %>
</div>