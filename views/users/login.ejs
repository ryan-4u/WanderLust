<% layout("/layouts/boilerplate") %>

<div class="auth-page">
  <div class="auth-card">

    <div class="auth-header">
      <i class="fa-regular fa-compass auth-icon"></i>
      <h2 class="auth-title">Welcome back</h2>
      <p class="auth-sub">Log in to your WanderLust account</p>
    </div>

    <form action="/login" method="POST" class="needs-validation" novalidate>

      <div class="form-group">
        <label class="form-lbl">Username</label>
        <input type="text" id="username" name="username" class="form-inp" placeholder="Your username" required>
        <div class="valid-feedback">Looks good!</div>
        <div class="invalid-feedback">Username is required</div>
      </div>

      <div class="form-group">
        <label class="form-lbl">Password</label>
        <input type="password" id="password" name="password" class="form-inp" placeholder="Your password" required>
        <div class="invalid-feedback">Password is required</div>
      </div>

      <button class="form-submit-btn" style="margin-top:0.5rem">Log In</button>

    </form>

    <p class="auth-switch">
      Don't have an account? <a href="/signup">Sign Up</a>
    </p>

  </div>
</div>