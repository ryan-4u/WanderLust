<% layout("/layouts/boilerplate") %>
<style>
  .f-info { display: none; }
  .container { padding-top: 0 !important; }
  .hero-slide { opacity: 0; }
</style>

<div class="hero-page">

  <!-- Left -->
  <div class="hero-left">
    <div class="hero-badge">
      <i class="fa-solid fa-fire"></i> Trusted by thousands of travelers
    </div>
    <h1 class="hero-title">
      Find your next<br>
      <span>perfect stay</span>
    </h1>
    <p class="hero-desc">
      Discover handpicked homes, cabins, villas and unique stays across the world. Every trip starts with the right place.
    </p>
    <div class="hero-actions">
      <a href="/listings" class="hero-btn-primary">Explore Stays</a>
      <a href="/listings/new" class="hero-btn-outline">List your Home</a>
    </div>
    <div class="hero-stats">
      <div class="hero-stat">
        <span class="hero-stat-num">500+</span>
        <span class="hero-stat-label">Listings</span>
      </div>
      <div class="hero-stat-divider"></div>
      <div class="hero-stat">
        <span class="hero-stat-num">11</span>
        <span class="hero-stat-label">Categories</span>
      </div>
      <div class="hero-stat-divider"></div>
      <div class="hero-stat">
        <span class="hero-stat-num">100%</span>
        <span class="hero-stat-label">Verified Hosts</span>
      </div>
    </div>
  </div>

  <!-- Right — rotating carousel -->
  <div class="hero-right">
    <div class="hero-carousel-wrap">
      <div class="hero-carousel" id="heroCarousel">
        <div class="hero-slide">
          <img src="https://images.unsplash.com/photo-1487958449943-2429e8be8625?w=600&q=80" alt="Trending">
          <span class="hero-slide-label">Trending</span>
        </div>
        <div class="hero-slide">
          <img src="https://images.unsplash.com/photo-1631049307264-da0ec9d70304?w=600&q=80" alt="Rooms">
          <span class="hero-slide-label">Rooms</span>
        </div>
        <div class="hero-slide">
          <img src="https://images.unsplash.com/photo-1477959858617-67f85cf4f1df?w=600&q=80" alt="Iconic Cities">
          <span class="hero-slide-label">Iconic Cities</span>
        </div>
        <div class="hero-slide">
          <img src="https://images.unsplash.com/photo-1464822759023-fed622ff2c3b?w=600&q=80" alt="Mountains">
          <span class="hero-slide-label">Mountains</span>
        </div>
        <div class="hero-slide">
          <img src="https://images.unsplash.com/photo-1533154683836-84ea7a0bc310?w=600&q=80" alt="Castle">
          <span class="hero-slide-label">Castle</span>
        </div>
        <div class="hero-slide">
          <img src="https://images.unsplash.com/photo-1575429198097-0414ec08e8cd?w=600&q=80" alt="Amazing Pools">
          <span class="hero-slide-label">Amazing Pools</span>
        </div>
        <div class="hero-slide">
          <img src="https://images.unsplash.com/photo-1504280390367-361c6d9f38f4?w=600&q=80" alt="Camping">
          <span class="hero-slide-label">Camping</span>
        </div>
        <div class="hero-slide">
          <img src="https://images.unsplash.com/photo-1500382017468-9049fed747ef?w=600&q=80" alt="Farms">
          <span class="hero-slide-label">Farms</span>
        </div>
        <div class="hero-slide">
          <img src="https://images.unsplash.com/photo-1551582045-6ec9c11d8697?w=600&q=80" alt="Arctic">
          <span class="hero-slide-label">Arctic</span>
        </div>
        <div class="hero-slide">
          <img src="https://images.unsplash.com/photo-1520250497591-112f2f40a3f4?w=600&q=80" alt="Domes">
          <span class="hero-slide-label">Domes</span>
        </div>
        <div class="hero-slide">
          <img src="https://images.unsplash.com/photo-1567899378494-47b22a2ae96a?w=600&q=80" alt="Boats">
          <span class="hero-slide-label">Boats</span>
        </div>
    </div>
  </div>

</div>

<script>
const slides = document.querySelectorAll('.hero-slide');
const total = slides.length;
let current = 0;

function updateCarousel() {
  slides.forEach((slide, i) => {
    slide.classList.remove('pos-prev', 'pos-active', 'pos-next', 'pos-hidden');

    const prev = (current + 1) % total;
    const next = (current - 1 + total) % total;

    if (i === prev)         slide.classList.add('pos-prev');
    else if (i === current) slide.classList.add('pos-active');
    else if (i === next)    slide.classList.add('pos-next');
    else                    slide.classList.add('pos-hidden');
  });
}

function nextSlide() {
  current = (current + 1) % total;
  updateCarousel();
}

updateCarousel();
setInterval(nextSlide, 3000);
</script>